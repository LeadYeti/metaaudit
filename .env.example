# Meta App credentials (from developers.facebook.com)
META_APP_ID=your_app_id_here
META_APP_SECRET=your_app_secret_here

# GHL webhook URLs
GHL_WEBHOOK_URL_LEAD=https://services.leadconnectorhq.com/hooks/your_webhook_id
GHL_WEBHOOK_URL_AUDIT=https://services.leadconnectorhq.com/hooks/your_webhook_id

# Session encryption key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=change_me_to_a_random_64_char_hex_string

# App URL (for OAuth redirect)
APP_URL=http://localhost:8000

# GHL Calendar URL (for CTA button)
GHL_CALENDAR_URL=https://app.leadyetipro.com/widget/booking/your_calendar_id
